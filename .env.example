# Copia este archivo a .env y completa con los valores reales.
# Vite solo expone al navegador las variables que empiezan con VITE_.

VITE_TENANT_ID=1392dab6-2ace-4798-8a92-0cb9a2fb0b99
VITE_SPA_CLIENT_ID=2a5839ad-9e91-4fff-94cb-f28febb1badf

# Scope completo, CON el prefijo api:// (a diferencia del backend, que lo usa
# SIN el prefijo — ver nota en README, es un detalle que confunde harto).
VITE_API_SCOPE=api://5af865ec-0324-4f82-a1e9-bbba4937c75e/access_as_user

# Debe calzar exacto con el redirect URI registrado en Azure AD para la SPA.
VITE_REDIRECT_URI=http://localhost:5173

# URL del BFF. En local, directo al BFF; en producción, la Invoke URL del
# API Gateway que arma Javier.
VITE_API_BASE_URL=http://localhost:8080
